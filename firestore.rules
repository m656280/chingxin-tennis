rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// 清心網球系統 — Firestore Security Rules
//
// 版本：v1.2-stopgap（2026-07-12）
//   變更：isValidFinanceType 改用前端實際型值（day_pass / coaching_fee，snake_case），
//         修正「臨打」無法建立（permission-denied）；status 白名單加入 refund。
// 前版：v1.1-stopgap（2026-07-08）
//   變更：members.create 新增分支 ② — admin/owner（Firebase Auth custom claims）
//         可建立 memberSource='manual'、status='approved' 的手動會員。
//         注意：Firebase Auth（issueFirebaseToken + signInWithCustomToken）已上線，
//         檔頭下方「Auth 尚未整合」的描述僅適用於尚未升級的其他 collection。
// 狀態：⚠️  STOPGAP — Firebase Auth 尚未整合，request.auth 恆為 null。
//       本版規則無法做身份驗證，僅能做資料形狀驗證 + 防止最高危操作。
//       待 Firebase Auth（Custom Token）整合後升級為 v2.0。
//
// 覆蓋 Collections：
//   members            前端讀寫（LIFF userId = document ID）
//   bookings           前端讀寫（active / cancelled / void / auto_moved）
//   financialRecords   前端讀寫（admin only，但目前無法驗證）
//   announcements      前端讀寫（admin only，但目前無法驗證）
//   notifications      前端讀寫（每個使用者看自己的）
//   duplicateIgnorePairs  前端讀寫（admin finance 工具）
//   sessions           Admin SDK 寫入（lineauth Cloud Function），前端不讀寫
//
// 已知限制（Firebase Auth 整合後移除）：
//   [L1] 無法驗證呼叫者身份 → 無法實現 isAdmin / isOwner 角色保護
//   [L2] financialRecords 理應僅 admin 可寫，但目前無法限制
//   [L3] announcements 理應僅 admin 可寫，但目前無法限制
//   [L4] notifications 理應僅限本人讀取，但目前全開
//   [L5] bookings.delete 理應僅 owner 可執行，但目前無法限制
//   [L6] members.delete 已封鎖（前端 owner-only，不常用，請改用 Firebase Console）
//
// 升級計畫：
//   1. lineauth 新增 admin.auth().createCustomToken(lineUserId)
//   2. 前端加入 firebase.auth().signInWithCustomToken(token)
//   3. members/{userId} 的 role 欄位寫入 request.auth.token.role（Custom Claims）
//   4. 升級至 v2.0 規則，移除所有 [Lx] 限制
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────────────────

    // 合法的 role 值（不含 owner / admin，防止自我升級）
    function isSafeMemberRole(role) {
      return role in ['member', 'coach'];
    }

    // 合法的 booking status 值
    function isValidBookingStatus(s) {
      return s in ['active', 'cancelled', 'void', 'auto_moved'];
    }

    function isGeneralBookingDurationAllowed(data) {
      return !('mode' in data)
        || !(data.mode in ['general', 'normal'])
        || (
          data.startTime is string
          && data.endTime is string
          && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && timestamp.value('1970-01-01T' + data.endTime + ':00Z')
               - timestamp.value('1970-01-01T' + data.startTime + ':00Z')
               <= duration.value(60, 'm')
        );
    }

    function isGeneralDailyLimitBooking(data) {
      return ('date' in data)
        && data.date is string
        && data.date >= '2026-08-10'
        && (!('mode' in data) || data.mode in ['general', 'normal'])
        && ('court' in data)
        && data.court in ['hard_a', 'hard_b'];
    }

    function isGeneralScheduleUpdateAllowed() {
      return (
          !isGeneralDailyLimitBooking(resource.data)
          && !isGeneralDailyLimitBooking(request.resource.data)
        )
        || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['date', 'startTime', 'endTime', 'court', 'mode']);
    }

    function isTeachingBooking(data) {
      return ('mode' in data)
        && data.mode in ['teaching', 'lesson', 'coaching'];
    }

    function isTeachingScheduleUpdateAllowed() {
      return (
          !isTeachingBooking(resource.data)
          && !isTeachingBooking(request.resource.data)
        )
        || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['date', 'startTime', 'endTime', 'court', 'mode',
                       'students', 'coachId']);
    }

    function isExtensionBooking(data) {
      return ('extensionStatus' in data)
        && data.extensionStatus == 'approved';
    }

    function isExtensionProtectedUpdateAllowed() {
      return !isExtensionBooking(resource.data)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'date', 'startTime', 'endTime', 'court', 'mode',
             'players', 'guests', 'participantCount', 'createdBy',
             'extensionStatus', 'extensionRequestId',
             'extensionApprovedByUid', 'extensionApprovedByName',
             'extensionApprovedAt'
           ]);
    }

    // 合法的 financialRecord type 值
    // v1.2 修正：前端實際使用 snake_case（day_pass / coaching_fee），
    //   原白名單誤寫駝峰（dayPass / coach）導致臨打 create 被拒（permission-denied）。
    //   駝峰舊值保留以防歷史資料/外部工具。
    function isValidFinanceType(t) {
      return t in ['annual', 'monthly', 'day_pass', 'dayPass',
                   'coaching_fee', 'coach_fee', 'coaching', 'coach',
                   'donate', 'other', 'expense'];
    }

    // 合法的 financialRecord status 值
    // v1.2：加入 'refund'（退款/修正，資料模型既有語意；避免編輯此類紀錄被拒）
    function isValidFinanceStatus(s) {
      return s in ['active', 'void', 'refund'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasActorMember() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function actorRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }

    function isAdminLike() {
      return hasActorMember() && actorRole() in ['owner', 'admin'];
    }

    function isOwner() {
      return hasActorMember() && actorRole() == 'owner';
    }

    function isViolationNotification(data) {
      return ('type' in data)
        && data.type in [
          'booking_violation_recorded',
          'booking_suspension_started',
          'booking_violation_revoked'
        ];
    }

    // ──────────────────────────────────────────────────────────────────────
    // sessions  — lineauth Admin SDK 寫入，前端目前不讀取
    // ──────────────────────────────────────────────────────────────────────
    match /sessions/{token} {
      // Admin SDK bypasses rules; client 無法寫入
      allow read:   if true;
      allow write:  if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // members
    // ──────────────────────────────────────────────────────────────────────
    match /members/{userId} {
      // 讀：全員可讀（場地頁、預約頁需要顯示所有使用者名稱）
      // TODO [L1]: 改為 request.auth != null 後限制
      allow read: if true;

      // 建立（v1.1：新增分支 ②）：
      // ① LIFF 首次登入自我註冊：role=member、status=pending、不可帶 approved
      //    ← 防止任何人透過 API 直接建立 owner/admin 帳號
      // ② 管理員手動建立（無 LINE 會員，memberSource='manual'）：
      //    需 Firebase Auth 登入且 custom token claims role 為 owner/admin，
      //    status 直接為 approved，role 僅限 member/coach（不可建 owner/admin）
      allow create: if (
                      // ① LIFF 自我註冊
                      request.resource.data.role == 'member'
                      && request.resource.data.status == 'pending'
                      && !('approved' in request.resource.data)
                      && request.resource.data.keys().hasAll(['uid', 'displayName', 'status', 'role', 'createdAt'])
                    ) || (
                      // ② admin/owner 手動建立
                      request.auth != null
                      && request.auth.token.role in ['owner', 'admin']
                      && request.resource.data.memberSource == 'manual'
                      && request.resource.data.status == 'approved'
                      && isSafeMemberRole(request.resource.data.role)
                      && request.resource.data.keys().hasAll(['uid', 'displayName', 'status', 'role', 'createdAt'])
                    );

      // 更新：
      // ① 如果 role 欄位未被異動 → 允許（display info, lastLoginAt, status 等）
      // ② 如果 role 欄位被異動 → 只允許設為 member / coach（不允許 owner / admin）
      // ← [L1] 限制：admin 可以把人升為 coach，但任何人都可以把自己改成 coach
      //              真正的 owner-only / admin-only 保護需要 Firebase Auth
      allow update: if (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || isSafeMemberRole(request.resource.data.role)
        )
        // owner 帳號的 role 不可被任何 client 端請求修改
        && (resource.data.role != 'owner'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        // 離會沿用前端既有權限：admin 不可操作 owner/admin，owner 不可被離會。
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            request.resource.data.status == 'deleted'
            && isAdminLike()
            && request.auth.uid != userId
            && resource.data.role != 'owner'
            && (actorRole() == 'owner' || resource.data.role != 'admin')
            && request.resource.data.approved == false
            && request.resource.data.deletedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approved', 'deletedAt'])
          )
          || (
            resource.data.status == 'deleted'
            && request.resource.data.status == 'approved'
            && isAdminLike()
            && request.resource.data.approved == true
            && request.resource.data.restoredAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approved', 'restoredAt'])
          )
          || (
            resource.data.status != 'deleted'
            && request.resource.data.status != 'deleted'
          )
        );

      // 刪除：全部封鎖。
      // permanentDeleteMember 是 owner-only 且極少使用，
      // 緊急情況請直接在 Firebase Console 刪除。
      // TODO [L1]: 改為 request.auth.token.role == 'owner' 後開放
      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // bookings
    // ──────────────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // 讀：全員可讀（場地日曆需要顯示所有預約）
      allow read: if true;

      // 建立：統一由 createBooking Callable 驗證會籍期限及硬地使用限制。
      allow create: if false;

      // 更新：Phase 1A 過渡防護。
      // participants / createdBy / participantCount 與 cancelled 一律改由 Callable 寫入。
      // 保留 creator/admin 的一般編輯與出席流程。
      // 參與者異動、owner 修復/作廢統一由 Callable 取得鎖後執行。
      allow update: if (
          isSignedIn()
          && isGeneralBookingDurationAllowed(request.resource.data)
          && isGeneralScheduleUpdateAllowed()
          && isTeachingScheduleUpdateAllowed()
          && isExtensionProtectedUpdateAllowed()
          && (
            (
              (
                (('createdBy' in resource.data)
                  && resource.data.createdBy == request.auth.uid)
                || isAdminLike()
              )
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny([
                      'date', 'startTime', 'endTime', 'court', 'mode',
                      'players', 'guests', 'participantCount', 'createdBy', 'status'
                    ])
            )
            || (
              hasActorMember()
              && (
                actorRole() == 'owner'
                || (
                  actorRole() == 'coach'
                  && ('coachId' in resource.data)
                  && resource.data.coachId == request.auth.uid
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['attendance', 'updatedAt'])
            )
            || (
              isOwner()
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny([
                      'date', 'startTime', 'endTime', 'court', 'mode',
                      'players', 'guests', 'participantCount', 'createdBy',
                      'status'
                    ])
            )
          )
        );

      // 永久刪除保留 owner 現有流程；一般 client 一律拒絕。
      allow delete: if isOwner();
    }

    // 最小 booking audit：僅 Admin SDK / Callable 可寫，client 全面禁止。
    match /bookingAuditLogs/{auditId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // 加時申請：所有狀態轉移由 Callable 執行，會員僅能讀自己的申請。
    match /bookingExtensionRequests/{requestId} {
      allow read: if isSignedIn()
                  && (isAdminLike()
                      || resource.data.requesterUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 加時申請 audit：僅 admin/owner 可讀，僅 Admin SDK 可寫。
    match /bookingExtensionAuditLogs/{auditId} {
      allow read: if isAdminLike();
      allow create, update, delete: if false;
    }

    // 依日期序列化 booking 建立與加時核准；client 不得讀寫。
    match /bookingMutationLocks/{lockId} {
      allow read, write: if false;
    }

    // 違規歷史：會員只能讀自己的紀錄；admin/owner 可讀全部。
    // 所有狀態轉移均由 Callable / Admin SDK 執行。
    match /bookingViolations/{violationId} {
      allow read: if isSignedIn()
                  && (isAdminLike()
                      || resource.data.memberUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 目前違規週期與停權狀態，client 僅能讀取，不得竄改。
    match /bookingViolationSummaries/{memberUid} {
      allow read: if isSignedIn()
                  && (isAdminLike() || memberUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 違規操作 audit：僅 admin/owner 可查閱，client 全面禁止寫入。
    match /bookingViolationAuditLogs/{auditId} {
      allow read: if isAdminLike();
      allow create, update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // financialRecords
    // ──────────────────────────────────────────────────────────────────────
    match /financialRecords/{recordId} {
      // 讀：全員可讀（月費會員看自己的記錄）
      // TODO [L2]: 改為限制 isAdmin 或 memberId == request.auth.uid 後限制
      allow read: if !isViolationNotification(resource.data)
                  || (isSignedIn()
                      && (resource.data.uid == request.auth.uid
                          || isAdminLike()));

      // 建立：驗證必要欄位
      allow create: if request.resource.data.keys().hasAll(['type', 'amount', 'date', 'status'])
                    && isValidFinanceType(request.resource.data.type)
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && isValidFinanceStatus(request.resource.data.status);

      // 更新：允許（admin 修改金額/作廢/合併等操作）
      // TODO [L2]: 改為 isAdmin 後限制
      allow update: if resource.data.status != 'void'
                    && isValidFinanceStatus(request.resource.data.status)
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;

      // 永久刪除：僅 owner。
      allow delete: if isOwner();
    }

    // 財務恢復 audit：僅 Admin SDK / Callable 可寫。
    match /financialAuditLogs/{auditId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // announcements
    // ──────────────────────────────────────────────────────────────────────
    match /announcements/{annId} {
      // 讀：全員可讀
      allow read: if true;

      // 寫：目前無法驗證 admin 身份，暫時全開
      // TODO [L3]: 改為 isAdmin 後限制
      allow create: if request.resource.data.keys().hasAll(['content', 'createdAt'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0;
      allow update: if true;
      allow delete: if true;
    }

    // ──────────────────────────────────────────────────────────────────────
    // notifications
    // ──────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // 讀：全員可讀（前端用 where uid == myUid 過濾）
      // TODO [L4]: 改為 resource.data.uid == request.auth.uid 後限制
      allow read: if true;

      // 建立：預約系統在建立/取消/移場時建立通知
      allow create: if request.resource.data.keys().hasAll(['uid', 'createdAt'])
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() > 0
                    && (
                      !('type' in request.resource.data)
                      || !(request.resource.data.type in [
                        'booking_extension_approved',
                        'booking_extension_rejected',
                        'booking_extension_revoked',
                        'booking_violation_recorded',
                        'booking_suspension_started',
                        'booking_violation_revoked'
                      ])
                    );

      // 更新：只允許標記已讀（read: true）和相關時間戳記
      // 防止通知內容被篡改
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'updatedAt'])
                    && request.resource.data.read == true
                    && (
                      !isViolationNotification(resource.data)
                      || (isSignedIn()
                          && (resource.data.uid == request.auth.uid
                              || isAdminLike()))
                    );

      // 刪除：允許（booking 永久刪除時清理對應通知）
      allow delete: if !isViolationNotification(resource.data);
    }

    // ──────────────────────────────────────────────────────────────────────
    // duplicateIgnorePairs  — 財務重複比對的例外名單
    // ──────────────────────────────────────────────────────────────────────
    match /duplicateIgnorePairs/{pairId} {
      allow read:   if true;
      // 建立：admin 財務工具標記「不是重複」
      // TODO: 改為 isAdmin 後限制
      allow create: if request.resource.data.keys().hasAll(['createdAt'])
                    && request.resource.data.createdAt != null;
      allow update: if false;
      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // catch-all — 明確拒絕所有未列出的 collection
    // ──────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
